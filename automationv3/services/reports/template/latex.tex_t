<#- The report's PDF: Sphinx's LaTeX template (delimiters <% %> and <%= %>), with the report's own title page,
     signature page and documents table before the document. Every automation.* value is already escaped
     for LaTeX:

       automation.company, .marking, .document_type   (template.json)
       automation.title, .number, .revision, .author, .date, .report_id, .manifest_hash
       automation.signatures [(role, name)]
       automation.applicable, .reference [{id, number, revision, title}]

     How the document's marked parts look: a verdict is \DUrole{verdict-<state>}{...} and a container
     \begin{sphinxuseclass}{<class>}, which use \DUroleverdict-<state> and the sphinxclass<class>
     environment when they're defined here, and leave the text as it is when not. -#>
%% Generated by Sphinx, from the report template's latex.tex_t
\def\sphinxdocclass{<%= docclass %>}
\documentclass[<%= papersize %>,<%= pointsize %><%= classoptions %>]{<%= wrapperclass %>}
\ifdefined\pdfpxdimen
   \let\sphinxpxdimen\pdfpxdimen\else\newdimen\sphinxpxdimen
\fi \sphinxpxdimen=<%= pxunit %>\relax
\PassOptionsToPackage{bookmarksdepth=5}{hyperref}
<%= passoptionstopackages %>
\PassOptionsToPackage{warn}{textcomp}
<%= inputenc %>
<%= utf8extra %>
<%= cmappkg %>
<%= fontenc %>
<%= amsmath %>
<%= multilingual %>
<%= substitutefont %>
<%= textcyrillic %>
<%= fontpkg %>
<%= fontsubstitution %>
<%= textgreek %>
\usepackage<%= sphinxpkgoptions %>{sphinx}
<%= sphinxsetup %>
<%= fvset %>
\usepackage[a4paper,margin=22mm,headheight=16mm,headsep=8mm,footskip=12mm]{geometry}
<%= extrapackages %>
<%- for name, option in packages %>
\usepackage<% if option %>[<%= option %>]<% endif %>{<%= name %>}
<%- endfor %>
<%= hyperref %>
<%- for name, option in packages_after_hyperref %>
\usepackage<% if option %>[<%= option %>]<% endif %>{<%= name %>}
<%- endfor %>
<%= contentsname %>
\usepackage{sphinxmessages}
<%= tocdepth %>
<%= secnumdepth %>
<%= preamble %>

\usepackage{lastpage,tabularx,booktabs}
\renewcommand{\familydefault}{\sfdefault}
\definecolor{acme}{HTML}{1F4E79}
\definecolor{verdictgood}{HTML}{2E7D32}
\definecolor{verdictbad}{HTML}{C62828}
\definecolor{verdictwarn}{HTML}{B26A00}
\definecolor{verdictnone}{HTML}{6B6B6B}
<%- for name, color in [("pass", "good"), ("green", "good"), ("true", "good"), ("fail", "bad"), ("red", "bad"),
                        ("error", "bad"), ("partial", "warn"), ("incomplete", "warn"), ("outdated", "warn"),
                        ("blocked", "warn"), ("text-changed-since", "warn"), ("untested", "none"),
                        ("unfinished", "none"), ("not-run", "none"), ("false", "none")] %>
\expandafter\def\csname DUroleverdict-<%= name %>\endcsname#1{\textcolor{verdict<%= color %>}{#1}}
<%- endfor %>
\newenvironment{sphinxclassrequirement}{\itshape}{}
\newenvironment{sphinxclassfailure}{\color{verdictbad}}{}
\hypersetup{colorlinks=true,linkcolor=acme,urlcolor=acme,
  pdftitle={<%= automation.title %>},pdfauthor={<%= automation.author %>}}
\sphinxsetup{TitleColor={HTML}{1F4E79}, InnerLinkColor={HTML}{1F4E79}, OuterLinkColor={HTML}{1F4E79}}

\fancypagestyle{normal}{%
  \fancyhf{}%
  \fancyhead[L]{\includegraphics[height=9mm]{logo}}%
  \fancyhead[C]{\small <%= automation.title %>}%
  \fancyhead[R]{\small <%= automation.number %>\\ Revision <%= automation.revision %>}%
  \fancyfoot[L]{\scriptsize\color{acme}<%= automation.marking %>}%
  \fancyfoot[R]{\small Page \thepage\ of \pageref*{LastPage}}%
  \renewcommand{\headrulewidth}{0.6pt}%
  \renewcommand{\footrulewidth}{0.4pt}}
\fancypagestyle{plain}{\pagestyle{normal}}

\title{<%= title %>}
\date{<%= date %>}
\author{<%= author %>}
\begin{document}
<%= shorthandoff %>
\begin{titlepage}
  \raggedright\setlength{\parindent}{0pt}
  \includegraphics[height=22mm]{logo}\par
  \vspace*{50mm}
  {\color{acme}\rule{\linewidth}{1.5pt}}\par\vspace{6mm}
  {\raggedright\Huge\bfseries <%= automation.title %>\par}
  \vspace{4mm}
  {\Large <%= automation.document_type %>\par}
  \vspace{6mm}
  {\color{acme}\rule{\linewidth}{1.5pt}}\par
  \vspace{20mm}
  {\large
  \begin{tabular}{@{}ll@{}}
    Document number & \textbf{<%= automation.number %>} \\[2pt]
    Revision & \textbf{<%= automation.revision %>} \\[2pt]
    Date & <%= automation.date %> \\[2pt]
    Author & <%= automation.author %> \\
  \end{tabular}\par}
  \vfill
  {\small\color{acme}<%= automation.company %> \hfill Report <%= automation.report_id %>}\par
  {\scriptsize Bundle manifest SHA-256: \texttt{<%= automation.manifest_hash %>}}\par
  \vspace{3mm}
  {\centering\small\bfseries\color{acme}<%= automation.marking %>\par}
\end{titlepage}
\setcounter{page}{2}
\pagestyle{normal}
\tableofcontents
\clearpage

\section*{Signatures}
\addcontentsline{toc}{section}{Signatures}
\renewcommand{\arraystretch}{2.6}
\begin{tabularx}{\linewidth}{|l|X|X|p{28mm}|}
  \hline
  \textbf{Role} & \textbf{Name} & \textbf{Signature} & \textbf{Date} \\
  \hline
<%- for role, name in automation.signatures %>
  <%= role %> & <%= name %> & & \\
  \hline
<%- endfor %>
\end{tabularx}
\renewcommand{\arraystretch}{1}
\clearpage

\section{Applicable and reference documents}
<%- for heading, documents, empty in [("Applicable documents", automation.applicable, "No applicable documents."),
                                     ("Reference documents", automation.reference, "No reference documents.")] %>
\subsection{<%= heading %>}
<%- if documents %>
\begin{tabularx}{\linewidth}{@{}lllX@{}}
  \toprule
  \textbf{ID} & \textbf{Number} & \textbf{Revision} & \textbf{Title} \\
  \midrule
<%- for d in documents %>
  <%= d.id %> & <%= d.number %> & <%= d.revision %> & <%= d.title %> \\
<%- endfor %>
  \bottomrule
\end{tabularx}
<%- else %>
<%= empty %>
<%- endif %>
<%- endfor %>

<%= body %>
<%= atendofbody %>
\end{document}
